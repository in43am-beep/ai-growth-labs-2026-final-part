# ===== RankForge AI — Environment Variables =====
# Copy this file to ".env" and fill in your real values.

# JWT signing secret for user auth tokens (use a long random string)
SECRET_KEY=your-jwt-secret-key-here

# Database connection (SQLite by default)
DATABASE_URL=sqlite:///./rankforge.db

# AI provider key used by the call/chat agents (optional — smart fallback works without it)
GEMINI_API_KEY=optional

# Optional integrations
SENDGRID_API_KEY=optional
OPENAI_API_KEY=optional

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://YOUR_DOMAIN_HERE

# Public URLs (used for OAuth redirects, Stripe success/cancel, email links)
PUBLIC_BASE_URL=https://rankforge-ai-production.up.railway.app
FRONTEND_BASE_URL=https://rankforge-ai.netlify.app

# ----- Email (SMTP) — enables forgot-password + questionnaire reminders -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your@email.com

# ----- Stripe (real payments). Without these, "Buy" uses simulated activation -----
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ----- Google OAuth ("Continue with Google") -----
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
# defaults to PUBLIC_BASE_URL + /api/auth/google/callback if omitted
GOOGLE_REDIRECT_URI=https://rankforge-ai-production.up.railway.app/api/auth/google/callback

# ----- Twilio (real outbound/inbound calls) -----
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ----- Background scheduler (questionnaire reminders) -----
ENABLE_SCHEDULER=true
REMINDER_INTERVAL_DAYS=2
MAX_REMINDERS=5

# ----- Beyond SEO brain + Apify data layer -----
# The Beyond SEO "brain" (dashboard/skills/beyond-seo/) is bundled in the repo and
# auto-injected into every AI chat/call + auto-report. No key needed for it.
# Apify gives the agents REAL crawl/SERP/backlink data. Without this token the
# reports run in "Advisory mode" (reasoning only, no invented data) — site never breaks.
APIFY_API_TOKEN=optional
